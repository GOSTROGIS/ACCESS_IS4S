# Replace @ROOT@ (install root) and @USER@ (app user), copy to /etc/systemd/system/, then
# systemctl daemon-reload && systemctl enable --now <unit>. All settings come from
# @ROOT@/config/autocraft.env, which the unit loads as the app user (README, "Production install").
[Unit]
Description=AutoCraft daily database snapshot

[Service]
Type=oneshot
User=@USER@
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash -c 'set -a; . @ROOT@/config/autocraft.env; set +a; exec /usr/bin/bash @ROOT@/app/deploy/backup.sh daily 7'
Nice=10
IOSchedulingClass=idle
