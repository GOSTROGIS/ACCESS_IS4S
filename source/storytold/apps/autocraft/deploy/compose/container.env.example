# Settings of the Compose stack (deploy/compose/compose.yaml). Copy to container.env, mode 0600, and fill in.
# One KEY=VALUE per line, no quotes. The image sets every path (/data, /config); do not set AUTOCRAFT_DB,
# AUTOCRAFT_SECRETS_FILE, cache, lock or listen settings here.

# Public origin of the dashboard: https, no path. GitHub sign-in callbacks and links are built from it.
AUTOCRAFT_BASE_URL=https://autocraft.example.com
# The reverse proxy sets X-Forwarded-For.
AUTOCRAFT_TRUST_PROXY=1

# GitHub token for gh (classic token with repo, read:org and workflow). Set the value here only.
GH_TOKEN=

# Optional. Discord: files under /config, mode 0600, owner uid 10001. The key must be the old install's file byte for byte.
#AUTOCRAFT_DISCORD_TOKEN_FILE=/config/discord-token
#AUTOCRAFT_DISCORD_KEY_FILE=/config/discord-key

# Optional. File under /config holding the image proxy's token (default: gh auth token).
#AUTOCRAFT_IMAGE_TOKEN_FILE=/config/image-token

# Optional. Logins of review bots whose comments never make a review stale.
#AUTOCRAFT_REVIEW_BOTS=coderabbitai,dependabot,renovate
