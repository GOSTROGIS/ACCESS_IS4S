# Settings of a production install, read by the systemd units and deploy/hook.sh.
# Copy to <root>/config/autocraft.env and replace @ROOT@ (install root, the app
# user's home) and @BASE_URL@ (public origin, https, no path). One KEY=VALUE per
# line, no quotes and no spaces in values: systemd and the hook's shell both read it.

# Dashboard
AUTOCRAFT_BASE_URL=@BASE_URL@
AUTOCRAFT_LISTEN=127.0.0.1:3005
AUTOCRAFT_TRUST_PROXY=1
AUTOCRAFT_SECRETS_FILE=@ROOT@/config/secrets.json

# Data and caches. XDG_CACHE_HOME covers the embedding model, image proxy and label caches.
AUTOCRAFT_DB=@ROOT@/data/mirror.db
XDG_CACHE_HOME=@ROOT@/cache
AUTOCRAFT_LOCK_DIR=@ROOT@/cache/autocraft/locks
AUTOCRAFT_RUNNER_LOGS=@ROOT@/cache/autocraft/jobs
AUTOCRAFT_DIFF_CACHE=@ROOT@/cache/autocraft/diffs
AUTOCRAFT_CHECKOUT_DIR=@ROOT@/cache/autocraft/checkouts
AUTOCRAFT_FIXUP_DIR=@ROOT@/cache/autocraft/fixups

# Runner and sandbox worker
AUTOCRAFT_WORKER_LISTEN=127.0.0.1:8981
AUTOCRAFT_ACCOUNTS=@ROOT@/config/accounts.json
# Config directories of accounts added on the dashboard's Accounts page, and their usage readings.
AUTOCRAFT_ACCOUNTS_ROOT=@ROOT@/config/claude
AUTOCRAFT_USAGE_DIR=@ROOT@/cache/autocraft/usage

# deploy/hook.sh
# claude updates happen by hand, so a model change never arrives unannounced.
DISABLE_AUTOUPDATER=1

AUTOCRAFT_BRANCH=main
