{
  "name": "autocraft",
  "license": "MIT OR Apache-2.0",
  "version": "0.1.0",
  "description": "Backlog mirror, triage pipeline state and dashboard for the storytold craft apps",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "autocraft": "src/cli.ts",
    "craft-auto": "src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run docs:check",
    "docs": "node scripts/gen-docs.ts",
    "docs:check": "node scripts/gen-docs.ts --check",
    "docs:image": "node scripts/flowchart-shot.mjs",
    "gql-schema": "scripts/gql-schema.sh",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "graphql": "^17.0.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@xterm/headless": "^6.0.0"
  }
}
