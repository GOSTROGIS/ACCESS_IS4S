diff --git a/src/dash/server/windows-secret-acl.ps1 b/src/dash/server/windows-secret-acl.ps1
new file mode 100644
index 0000000..3d5a72f
--- /dev/null
+++ b/src/dash/server/windows-secret-acl.ps1
@@ -0,0 +1,57 @@
+param(
+    [Parameter(Mandatory)][ValidateSet('CheckFile', 'CheckDirectory', 'ProtectDirectory')][string]$Action,
+    [Parameter(Mandatory)][string]$LiteralPath
+)
+
+$ErrorActionPreference = 'Stop'
+$owner = [Security.Principal.WindowsIdentity]::GetCurrent().User
+$trusted = @($owner.Value, 'S-1-5-18', 'S-1-5-32-544')
+
+function Get-OwnedItem([string]$Path, [bool]$Directory) {
+    $item = Get-Item -LiteralPath $Path -Force
+    if ($item.PSIsContainer -ne $Directory -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
+        throw 'A reparse point or unexpected file type cannot hold AutoCraft secrets.'
+    }
+    $acl = Get-Acl -LiteralPath $item.FullName
+    if ($acl.GetOwner([Security.Principal.SecurityIdentifier]) -ne $owner) {
+        throw 'The running Windows account must own AutoCraft private data.'
+    }
+    return $acl
+}
+
+function Assert-PrivateAcl([string]$Path, [bool]$Directory) {
+    $acl = Get-OwnedItem $Path $Directory
+    $descriptor = [Security.AccessControl.RawSecurityDescriptor]::new($acl.GetSecurityDescriptorBinaryForm(), 0)
+    if (($Directory -and -not $acl.AreAccessRulesProtected) -or $null -eq $descriptor.DiscretionaryAcl) {
+        throw 'AutoCraft private data must have an explicit Windows access policy.'
+    }
+    $ownerMode = [int][Security.AccessControl.FileSystemRights]::FullControl
+    $ownerInheritance = [int][Security.AccessControl.AceFlags]::ContainerInherit -bor [int][Security.AccessControl.AceFlags]::ObjectInherit
+    $propagation = $ownerInheritance -bor [int][Security.AccessControl.AceFlags]::InheritOnly -bor [int][Security.AccessControl.AceFlags]::NoPropagateInherit
+    $inheritsOwner = $false
+    foreach ($ace in $descriptor.DiscretionaryAcl) {
+        if ($ace.AceType -ne [Security.AccessControl.AceType]::AccessAllowed -or $ace.SecurityIdentifier.Value -notin $trusted) {
+            throw 'AutoCraft private data grants access outside the running Windows account, SYSTEM and Administrators.'
+        }
+        if ($ace.SecurityIdentifier -eq $owner -and ([int]$ace.AceFlags -band $propagation) -eq $ownerInheritance -and ($ace.AccessMask -band $ownerMode) -eq $ownerMode) {
+            $inheritsOwner = $true
+        }
+    }
+    if ($Directory -and -not $inheritsOwner) {
+        throw 'New private files must inherit access for the running Windows account.'
+    }
+}
+
+if ($Action -eq 'ProtectDirectory') {
+    $null = Get-OwnedItem $LiteralPath $true
+    $icacls = Join-Path $env:SystemRoot 'System32\icacls.exe'
+    $permissions = $trusted | Select-Object -Unique | ForEach-Object { '*' + $_ + ':(OI)(CI)F' }
+    & $icacls $LiteralPath '/inheritance:r' '/grant:r' $permissions | Out-Null
+    if ($LASTEXITCODE -ne 0) { throw 'Windows did not accept the AutoCraft directory access policy.' }
+}
+if ($Action -eq 'CheckFile') {
+    Assert-PrivateAcl (Split-Path -LiteralPath $LiteralPath) $true
+    Assert-PrivateAcl $LiteralPath $false
+} else {
+    Assert-PrivateAcl $LiteralPath $true
+}
diff --git a/src/dash/server/windows-secret-acl.ts b/src/dash/server/windows-secret-acl.ts
new file mode 100644
index 0000000..435af93
--- /dev/null
+++ b/src/dash/server/windows-secret-acl.ts
@@ -0,0 +1,22 @@
+import { spawnSync } from "node:child_process";
+import { realpathSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+type Action = "CheckFile" | "CheckDirectory" | "ProtectDirectory";
+
+export function windowsSecretAcl(action: Action, input: string): void {
+  const path = resolve(input);
+  if (!/^[a-z]:\\[^:]+$/i.test(path) || realpathSync.native(path).toLowerCase() !== path.toLowerCase()) {
+    throw new Error("AutoCraft private data needs a regular local path without reparse points or alternate streams.");
+  }
+  const powershellHome = join(process.env.SystemRoot ?? "C:\\Windows", "System32", "WindowsPowerShell", "v1.0");
+  const powershell = join(powershellHome, "powershell.exe");
+  const script = fileURLToPath(new URL("./windows-secret-acl.ps1", import.meta.url));
+  const env = Object.fromEntries(Object.entries(process.env).filter(([name]) => name.toLowerCase() !== "psmodulepath"));
+  env.PSModulePath = join(powershellHome, "Modules");
+  const result = spawnSync(powershell, ["-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "RemoteSigned", "-File", script, "-Action", action, "-LiteralPath", path], {
+    env, stdio: "ignore", windowsHide: true, timeout: 15_000,
+  });
+  if (result.status !== 0) throw new Error("AutoCraft private data failed the Windows ACL check.");
+}
diff --git a/windows-folder.mjs b/windows-folder.mjs
new file mode 100644
index 0000000..233ff8f
--- /dev/null
+++ b/windows-folder.mjs
@@ -0,0 +1,41 @@
+import { spawn } from 'node:child_process';
+import { existsSync, mkdirSync } from 'node:fs';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { windowsSecretAcl } from './src/dash/server/windows-secret-acl.ts';
+
+const root = fileURLToPath(new URL('.', import.meta.url));
+const privateDir = join(root, '.private');
+const defaultSecrets = join(privateDir, 'secrets.json');
+const callback = 'http://127.0.0.1:8993';
+const [mode, ...args] = process.argv.slice(2);
+
+try {
+  if (!existsSync(privateDir)) {
+    mkdirSync(privateDir);
+    windowsSecretAcl('ProtectDirectory', privateDir);
+  }
+  if (mode === 'protect') {
+    windowsSecretAcl('ProtectDirectory', privateDir);
+    console.log('AutoCraft private folder protected. Keep the OAuth secrets file here.');
+  } else {
+    windowsSecretAcl('CheckDirectory', privateDir);
+    const env = {
+      ...process.env,
+      AUTOCRAFT_BASE_URL: callback,
+      AUTOCRAFT_LISTEN: '127.0.0.1:8993',
+      AUTOCRAFT_DEV_AUTH: '0',
+      AUTOCRAFT_TRUST_PROXY: '0',
+      AUTOCRAFT_DB: process.env.AUTOCRAFT_DB || join(privateDir, 'mirror.db'),
+      AUTOCRAFT_SECRETS_FILE: process.env.AUTOCRAFT_SECRETS_FILE || defaultSecrets,
+      AUTOCRAFT_LOCK_DIR: process.env.AUTOCRAFT_LOCK_DIR || join(privateDir, 'locks'),
+    };
+    const command = mode === 'dashboard' ? ['dash', 'serve'] : args;
+    const child = spawn(process.execPath, [join(root, 'src', 'cli.ts'), ...command], { cwd: root, env, stdio: 'inherit' });
+    child.on('error', () => { process.exitCode = 1; console.error('Could not start AutoCraft.'); });
+    child.on('exit', (code) => { process.exitCode = code ?? 1; });
+  }
+} catch (error) {
+  console.error(error.message);
+  process.exitCode = 1;
+}
