# Copy to a private .env beside compose.yaml; do not commit that copy.
# This bundle is prepared, not a running or fully tested native tool service.
PUID=1000
PGID=1000
TZ=America/Los_Angeles
DESKTOP_USERNAME=is4s

# Required: actual external HTTPS origin, without a trailing slash.
# Put an authentication gateway in front of it before internet exposure.
DESKTOP_ORIGIN=

# Required: private file containing a strong password; store outside the checkout.
# Its value is read through LinuxServer's supported FILE__PASSWORD mechanism.
DESKTOP_PASSWORD_FILE=
DESKTOP_HTTP_PORT=3000
